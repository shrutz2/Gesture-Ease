# Keep secrets, training data, and junk OUT of the deployed image.
**/__pycache__
**/*.pyc
**/.pytest_cache

# Secrets — never bake into the image
backend/.env
frontend/.env

# Training data / experiments (not needed to serve the app)
# NOTE: backend/data/videos (55 MB of sign reference clips) IS kept so the
# practice videos show; only the heavy training data is excluded.
backend/dataset
backend/data/landmarks
backend/experiments
backend/ml_env
backend/instance
backend/configs
backend/scripts
backend/tests
backend/*.csv

# Frontend deps / prebuilt output (image rebuilds these)
frontend/node_modules
frontend/build

# Repo / editor / docs cruft
.git
.github
*.pdf
*.md
