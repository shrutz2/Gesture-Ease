# copy to .env and fill in real values

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/gesture_ease

# JWT signing secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# allowed frontend origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

FLASK_ENV=development
