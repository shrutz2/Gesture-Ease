# Gesture-Ease backend configuration — copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# --- Database ---
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/gesture_ease

# --- Security ---
# Strong random secret used to sign JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the app generates a random secret at startup (tokens won't
# survive a restart), so always set this in production.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Comma-separated list of front-end origins allowed to call the API (CORS).
# Wildcard "*" is intentionally NOT used.
ALLOWED_ORIGINS=http://localhost:3000

# --- App ---
FLASK_ENV=development
